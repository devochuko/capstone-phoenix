# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

aws_region          = "eu-north-1"
name_prefix         = "phoenix"
vpc_cidr            = "10.42.0.0/16"
public_subnet_cidr  = "10.42.1.0/24"
availability_zone   = "eu-north-1a"

# Your public IP in CIDR form — find it with: curl -s https://checkip.amazonaws.com
admin_cidr = "203.0.113.4/32"

instance_type = "t3.small"
worker_count  = 2

# Must be an EXISTING EC2 key pair name in this region.
# Create one with:
#   aws ec2 create-key-pair --key-name phoenix-key --region eu-north-1 \
#     --query 'KeyMaterial' --output text > ~/.ssh/phoenix-key.pem
#   chmod 400 ~/.ssh/phoenix-key.pem
ssh_key_name = "phoenix-key"
